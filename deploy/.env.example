# Farwork hub — deployment values for deploy/docker-compose.yml.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env   # then fill it in
#
# .env is git-ignored (.gitignore: ".env", ".env.*" with "!.env.example"), and it
# is the only place the real values live. Everything below is a placeholder.

# ---- image -------------------------------------------------------------------
# Which published image to run: a git tag (v0.1.0), a commit tag (sha-1a2b3c4) or
# latest. This is the rollback knob — see deploy/README.md.
FARWORK_TAG=latest

# ---- hub ---------------------------------------------------------------------
# What the hub dials. Host is the PostgreSQL container name on 1panel-network
# (docker ps / 1Panel -> Containers), never 127.0.0.1: inside the container that
# means the hub itself. Must match DB_HOST / DB_USER / DB_PASSWORD / DB_NAME below.
DATABASE_URL=postgres://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@CHANGE_ME_DB_HOST:5432/CHANGE_ME_DB_NAME
# Signs every user token. Generate once with: openssl rand -hex 32
# Changing it logs everybody out (and invalidates outstanding pairing codes).
FARWORK_HUB_SECRET=CHANGE_ME_openssl_rand_hex_32
# Public origin, scheme included, no trailing slash. Copied verbatim into pairing
# commands, so it must be the address a browser and an agent can both reach — the
# reverse-proxy domain, not the loopback port.
FARWORK_HUB_PUBLIC_URL=https://farwork.xacalc.cn

# ---- db-init -----------------------------------------------------------------
# The existing PostgreSQL instance (installed as an app, not through 1Panel's
# Database module — see the comment in docker-compose.yml).
DB_HOST=CHANGE_ME_postgres_container_name
# Admin identity, used only to connect and create the role/database.
POSTGRES_ADMIN_USER=CHANGE_ME_admin_user
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_admin_password
# Application role and database db-init creates (idempotent). DB_PASSWORD is also
# what DATABASE_URL must carry — db-init keeps it in sync on every up -d.
DB_USER=farwork
DB_PASSWORD=CHANGE_ME_app_password
DB_NAME=farwork
